rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function ownerAccount() {
      return signedIn() && request.auth.token.email == 'contact.hamzutrader@gmail.com';
    }
    function userExists() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function adminExists() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    function adminRecord() {
      return get(/databases/$(database)/documents/admins/$(request.auth.uid)).data;
    }
    function activeStaff() {
      return ownerAccount() || (adminExists() && adminRecord().get('suspended', false) == false);
    }
    function hasPermission(permission) {
      return ownerAccount()
        || (adminExists()
          && adminRecord().get('suspended', false) == false
          && permission in adminRecord().get('permissions', []));
    }
    function publicRole(role) {
      return role in ['customer', 'tasker'];
    }
    function signupsAllowed() {
      return !exists(/databases/$(database)/documents/settings/platform)
        || get(/databases/$(database)/documents/settings/platform).data.get('allowNewSignups', true) == true;
    }
    function task(taskId) {
      return get(/databases/$(database)/documents/tasks/$(taskId)).data;
    }
    function hasPrivateInvite(taskId) {
      return signedIn()
        && exists(/databases/$(database)/documents/task_invites/$(taskId))
        && get(/databases/$(database)/documents/task_invites/$(taskId)).data.userId == request.auth.uid;
    }
    function canReadOperationalTasks() {
      return hasPermission('approveTasks')
        || hasPermission('manageContent')
        || hasPermission('viewAnalytics')
        || hasPermission('managePayments');
    }
    function canReadUserRecords() {
      return hasPermission('manageUsers')
        || hasPermission('manageAdmins')
        || hasPermission('approveTasks')
        || hasPermission('viewAnalytics');
    }
    function selfUserUpdateAllowed() {
      return request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email
        && publicRole(resource.data.role)
        && publicRole(request.resource.data.role)
        && request.resource.data.get('isTasker', false) == (request.resource.data.role == 'tasker')
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name', 'role', 'isTasker', 'avatarUrl', 'city', 'bio', 'professionalTitle', 'skills',
          'hourlyRate', 'experienceYears', 'languages', 'availability', 'portfolioUrl', 'certifications',
          'organization', 'hiringNeeds', 'onboarded', 'profileComplete', 'roleUpdatedAt', 'profileUpdatedAt'
        ]);
    }
    function managedUserUpdateAllowed() {
      return request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name', 'role', 'isTasker', 'avatarUrl', 'city', 'bio', 'professionalTitle', 'skills',
          'hourlyRate', 'experienceYears', 'languages', 'availability', 'portfolioUrl', 'certifications',
          'organization', 'hiringNeeds', 'onboarded', 'profileComplete', 'roleUpdatedAt', 'profileUpdatedAt',
          'isPrivate', 'suspended', 'suspendedReason', 'suspendedAt', 'verified',
          'interviewStatus', 'interviewUpdatedAt', 'interviewVerifiedAt'
        ])
        && publicRole(request.resource.data.role);
    }
    function paymentUserUpdateAllowed() {
      return request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['wallet']);
    }
    function validSignupDocument(uid) {
      return signedIn()
        && request.auth.uid == uid
        && signupsAllowed()
        && request.auth.token.email != null
        && request.resource.data.uid == uid
        && request.resource.data.email == request.auth.token.email
        && publicRole(request.resource.data.role)
        && request.resource.data.get('isTasker', false) == (request.resource.data.role == 'tasker')
        && request.resource.data.get('isPrivate', false) == false
        && request.resource.data.get('wallet', 0) == 0
        && request.resource.data.get('verified', false) == false
        && request.resource.data.get('suspended', false) == false
        && request.resource.data.get('trustScore', -1) == -1
        && request.resource.data.get('trustPenalty', 0) == 0
        && request.resource.data.get('onboarded', false) == false
        && request.resource.data.get('profileComplete', false) == false
        && request.resource.data.get('interviewStatus', 'not_started') == 'not_started'
        && request.resource.data.get('interviewScore', -1) == -1
        && request.resource.data.get('interviewSummary', '') == ''
        && request.resource.data.get('interviewTopSkills', []).size() == 0
        && request.resource.data.get('interviewAttemptNumber', 0) == 0
        && request.resource.data.get('interviewVerifiedAt', '') == ''
        && request.resource.data.get('interviewUpdatedAt', '') == '';
    }
    function validSettings() {
      return request.resource.data.keys().hasOnly([
          'autoApprove', 'clientFeePercent', 'freelancerFeePercent', 'minTaskBudget',
          'maintenanceMode', 'allowNewSignups', 'requireInterviewToBid'
        ])
        && request.resource.data.get('autoApprove', false) is bool
        && request.resource.data.get('clientFeePercent', 0) is number
        && request.resource.data.get('clientFeePercent', 0) >= 0
        && request.resource.data.get('clientFeePercent', 0) <= 30
        && request.resource.data.get('freelancerFeePercent', 15) is number
        && request.resource.data.get('freelancerFeePercent', 15) >= 0
        && request.resource.data.get('freelancerFeePercent', 15) <= 30
        && request.resource.data.get('minTaskBudget', 500) is number
        && request.resource.data.get('minTaskBudget', 500) >= 100
        && request.resource.data.get('minTaskBudget', 500) <= 10000000
        && request.resource.data.get('maintenanceMode', false) is bool
        && request.resource.data.get('allowNewSignups', true) is bool
        && request.resource.data.get('requireInterviewToBid', false) is bool;
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || canReadUserRecords() || hasPermission('managePayments'));
      allow create: if (ownerAccount() && request.auth.uid == uid
          && request.resource.data.uid == uid
          && request.resource.data.role == 'super_admin')
        || validSignupDocument(uid);
      allow update: if signedIn() && request.auth.uid == uid && selfUserUpdateAllowed()
        || (hasPermission('manageUsers') && managedUserUpdateAllowed())
        || (hasPermission('managePayments') && paymentUserUpdateAllowed());
      allow delete: if hasPermission('manageUsers');

      match /saved_tasks/{taskId} {
        allow read, write: if signedIn() && request.auth.uid == uid;
      }
    }

    match /public_profiles/{uid} {
      allow read: if resource.data.role == 'customer'
        || resource.data.get('discoverable', false) == true
        || (signedIn() && request.auth.uid == uid)
        || hasPermission('manageUsers');
      allow write: if false;
    }

    match /tasks/{taskId} {
      allow read: if (resource.data.visibility == 'public'
          && !(resource.data.status in ['draft', 'pending', 'rejected']))
        || (signedIn() && (resource.data.posterId == request.auth.uid
          || resource.data.assignedTo == request.auth.uid))
        || canReadOperationalTasks()
        || hasPrivateInvite(taskId);
      allow create, update, delete: if false;
    }

    match /bids/{bidId} {
      allow read: if signedIn() && (
        resource.data.bidderId == request.auth.uid
        || task(resource.data.taskId).posterId == request.auth.uid
        || hasPermission('approveTasks')
        || hasPermission('viewAnalytics')
        || hasPermission('managePayments')
      );
      allow create, update, delete: if false;
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow create, update, delete: if false;
    }

    match /conversations/{convId} {
      function participant(data) {
        return signedIn() && request.auth.uid in data.participants;
      }
      allow read: if participant(resource.data) || hasPermission('manageContent');
      allow create, update, delete: if false;

      match /messages/{messageId} {
        function conversationParticipant() {
          return signedIn()
            && request.auth.uid in get(/databases/$(database)/documents/conversations/$(convId)).data.participants;
        }
        allow read: if conversationParticipant() || hasPermission('manageContent');
        allow create, update, delete: if false;
      }
    }

    match /notifications/{notificationId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if false;
      allow update: if signedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow delete: if false;
    }

    match /wallet_txs/{transactionId} {
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || hasPermission('managePayments'));
      allow create, update, delete: if false;
    }

    match /disputes/{disputeId} {
      allow read: if signedIn() && (
        resource.data.openedBy == request.auth.uid
        || resource.data.respondentId == request.auth.uid
        || hasPermission('managePayments')
      );
      allow create, delete: if false;
      allow update: if hasPermission('managePayments')
        && request.resource.data.taskId == resource.data.taskId
        && request.resource.data.openedBy == resource.data.openedBy
        && request.resource.data.respondentId == resource.data.respondentId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'resolvedBy', 'resolvedAt', 'resolutionNote', 'updatedAt'
        ]);
    }

    match /admins/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || hasPermission('manageAdmins') || ownerAccount());
      allow create: if hasPermission('manageAdmins')
        && request.resource.data.uid == uid
        && request.resource.data.staffRole in ['editor', 'moderator', 'admin']
        && request.resource.data.email != 'contact.hamzutrader@gmail.com'
        && request.resource.data.get('suspended', false) == false;
      allow update: if hasPermission('manageAdmins')
        && resource.data.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.email == resource.data.email
        && request.resource.data.staffRole in ['editor', 'moderator', 'admin'];
      allow delete: if hasPermission('manageAdmins');
    }

    match /task_invites/{taskId} {
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || hasPermission('approveTasks'));
      allow create, update, delete: if false;
    }

    match /interviews/{uid} {
      allow read: if signedIn() && (
        request.auth.uid == uid
        || hasPermission('manageUsers')
        || hasPermission('approveTasks')
      );
      allow create, delete: if false;
      allow update: if hasPermission('manageUsers')
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.attemptId == resource.data.attemptId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'reviewedAt', 'reviewedBy', 'reviewNote', 'updatedAt'
        ]);

      match /history/{attemptId} {
        allow read: if signedIn() && (
          request.auth.uid == uid
          || hasPermission('manageUsers')
          || hasPermission('approveTasks')
        );
        allow write: if false;
      }
    }

    match /settings/{documentId} {
      allow read: if true;
      allow create, update: if documentId == 'platform' && hasPermission('manageContent') && validSettings();
      allow delete: if false;
    }

    match /audit_logs/{entryId} {
      allow read: if hasPermission('manageAdmins') || hasPermission('manageUsers') || hasPermission('managePayments');
      allow create: if activeStaff()
        && request.resource.data.actorId == request.auth.uid
        && request.resource.data.actorEmail == request.auth.token.email;
      allow update, delete: if false;
    }
  }
}
